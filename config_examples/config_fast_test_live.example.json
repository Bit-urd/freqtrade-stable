{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "fast_test",
  "strategy": "Ma200BtcRegimeFullCycleFastTestStrategy",
  "initial_state": "stopped",
  "dry_run": false,
  "trading_mode": "spot",
  "timeframe": "15m",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dataformat_ohlcv": "feather",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT"],
    "pair_blacklist": [],
    "ccxt_config": {"options": {"defaultType": "spot"}}
  },
  "pairlists": [{"method": "StaticPairList"}],
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "position_adjustment_enable": true,
  "internals": {"process_throttle_secs": 5}
}
